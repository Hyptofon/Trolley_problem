# Server-only environment variables for Next.js on Vercel + Upstash Redis
# Copy to .env.local for local development. Never commit .env.local to Git!

# 1. Upstash Redis REST Credentials (from Vercel Marketplace -> Upstash or console.upstash.com)
UPSTASH_REDIS_REST_URL=https://example-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...your_upstash_rest_token

# 2. Salted scrypt hash of the admin password
# Generate using: npm run generate-hash
ADMIN_PASSWORD_HASH=16384:8:1$salt_hex$derived_key_hex

# 3. Static secret for HMAC-SHA256 browser participantId hashing (32+ chars)
# Do not rotate frequently as it changes participant identity mapping
VOTE_ID_HMAC_SECRET=replace-with-a-random-secret-string-at-least-32-chars

# 4. Environment-isolated Redis key prefix (e.g. trolley:production:v1, trolley:development:v1)
REDIS_KEY_PREFIX=trolley:development:v1

# 5. Local development demo mode (allowed ONLY when NODE_ENV=development)
# When true in development without Redis, enables safe local in-memory testing with visible banner.
DEMO_MODE=false
